{
  "manifest_version": 3,
  "name": "TabGuard - Trust-first Tab Manager",
  "version": "0.2.3",
  "description": "Save, restore, and back up your tabs with verification. No silent failures.",
  "permissions": [
    "tabs",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TabGuard"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}